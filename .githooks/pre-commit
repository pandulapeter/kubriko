# The checks tests.yml runs that take seconds, run before every commit instead, so that nothing they refuse reaches
# the branch and waits there for a nightly run or a release to fail. Enabled once per clone with
# `git config core.hooksPath .githooks`.
set -e
python3 .github/scripts/check_license_headers.py
python3 .github/scripts/check_sizes.py
python3 .github/scripts/check_doc_names.py --staged
python3 .github/scripts/check_regexes.py
# Spotless and the unit tests need Gradle, so they run only when the commit stages more than Markdown. Gradle reruns only
# the tests of the modules a change reaches: seconds when none, longer for Kubriko Creator or the engine. Both read the
# working tree, which is what the staged files are unless a commit stages part of a file. The opt-in suites and the
# stress mode stay in CI.
if git diff --cached --name-only --diff-filter=ACMRD | grep -qvE '\.md$'; then
    # Git exports these to hooks (in a linked worktree, GIT_DIR names its folder under .git/worktrees), and JGit's init
    # honours them, so Kubriko Creator's git tests would create their repositories there instead of in temporary folders.
    unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE
    ./gradlew spotlessCheck desktopTest :creator:allTests --quiet
fi
