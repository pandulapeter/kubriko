import org.jetbrains.kotlin.gradle.ExperimentalWasmDsl

plugins {
    alias(libs.plugins.kotlin.multiplatform)
    alias(libs.plugins.compose)
    alias(libs.plugins.compose.compiler)
    alias(libs.plugins.kotlin.serialization)
}

kotlin {
    jvmToolchain(21)
    jvm("desktop")
    @OptIn(ExperimentalWasmDsl::class)
    wasmJs {
        browser()
        binaries.executable()
    }
    sourceSets {
        commonMain.dependencies {
            implementation(libs.compose.resources)
            implementation(libs.kubriko.creatorApi)
            implementation(libs.kubriko.engine)
            implementation(libs.kubriko.serialization)
        }
        getByName("desktopMain").dependencies {
            implementation(compose.desktop.currentOs)
        }
    }
}

compose.desktop {
    application {
        mainClass = "{{PACKAGE}}.MainKt"
    }
}

compose.resources {
    packageOfResClass = "{{PACKAGE}}.resources"
}

val gameName = providers.gradleProperty("game.name").orElse(rootProject.name)
val gameVersionName = providers.gradleProperty("game.versionName").orElse("1.0.0")
val gameVersionNumber = providers.gradleProperty("game.versionNumber").orElse("1")
val gameApplicationId = providers.gradleProperty("game.applicationId").orElse("{{PACKAGE}}")
val gameVendor = providers.gradleProperty("game.vendor").orElse("")
val gameDescription = providers.gradleProperty("game.description").orElse("")

val generateGameInfo by tasks.registering {
    val directory = layout.buildDirectory.dir("generated/gameInfo")
    val texts = mapOf(
        "NAME" to gameName,
        "VERSION_NAME" to gameVersionName,
        "APPLICATION_ID" to gameApplicationId,
        "VENDOR" to gameVendor,
        "DESCRIPTION" to gameDescription,
    )
    val versionNumber = gameVersionNumber
    texts.forEach { (key, value) -> inputs.property(key, value) }
    inputs.property("VERSION_NUMBER", versionNumber)
    outputs.dir(directory)
    doLast {
        fun literal(value: String) = "\"" + value.replace("\\", "\\\\").replace("\"", "\\\"").replace("$", "\\$") + "\""
        val constants = texts.entries.joinToString("") { (key, value) -> "    const val $key = ${literal(value.get())}\n" } +
            "    const val VERSION_NUMBER = ${versionNumber.get().trim().toInt()}\n"
        directory.get().file("GameInfo.kt").asFile.apply {
            parentFile.mkdirs()
            writeText("package {{PACKAGE}}\n\nobject GameInfo {\n${constants}}\n")
        }
    }
}

kotlin.sourceSets.commonMain {
    kotlin.srcDir(generateGameInfo)
}

compose.desktop.application.nativeDistributions {
    packageName = gameName.get()
    packageVersion = gameVersionName.get()
    vendor = gameVendor.get()
    description = gameDescription.get()
    macOS.bundleID = gameApplicationId.get()
}

tasks.named<ProcessResources>("wasmJsProcessResources") {
    val title = gameName.map { it.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;") }
    inputs.property("title", title)
    filesMatching("index.html") {
        filter { it.replace("@GAME_NAME@", title.get()) }
    }
}

val gameFirstScene = providers.gradleProperty("game.firstScene").orElse("main")
val gameAspectRatio = providers.gradleProperty("game.aspectRatio").orElse("dynamic")
val gameViewportWidth = providers.gradleProperty("game.viewportWidth").orElse("1920")
val gameViewportHeight = providers.gradleProperty("game.viewportHeight").orElse("1080")
val gameFrameRate = providers.gradleProperty("game.frameRate").orElse("60")

val generateGameSettings by tasks.registering {
    val directory = layout.buildDirectory.dir("generated/gameSettings")
    val values = mapOf(
        "game.firstScene" to gameFirstScene,
        "game.aspectRatio" to gameAspectRatio,
        "game.viewportWidth" to gameViewportWidth,
        "game.viewportHeight" to gameViewportHeight,
        "game.frameRate" to gameFrameRate,
    )
    values.forEach { (key, value) -> inputs.property(key, value) }
    outputs.dir(directory)
    doLast {
        fun value(key: String) = values.getValue(key).get().trim()
        fun size(key: String) = value(key).toFloatOrNull()?.takeIf { it in 1f..100000f }
            ?: throw GradleException("$key in gradle.properties is a number from 1 to 100000, not \"${value(key)}\".")
        fun width() = "${size("game.viewportWidth")}f.sceneUnit"
        fun height() = "${size("game.viewportHeight")}f.sceneUnit"
        val aspectRatioMode = when (val mode = value("game.aspectRatio")) {
            "dynamic" -> "ViewportManager.AspectRatioMode.Dynamic"
            "fitHorizontal" -> "ViewportManager.AspectRatioMode.FitHorizontal(${width()})"
            "fitVertical" -> "ViewportManager.AspectRatioMode.FitVertical(${height()})"
            "fixed" -> "ViewportManager.AspectRatioMode.Fixed(ratio = ${size("game.viewportWidth") / size("game.viewportHeight")}f, width = ${width()})"
            "stretched" -> "ViewportManager.AspectRatioMode.Stretched(SceneSize(${width()}, ${height()}))"
            else -> throw GradleException("game.aspectRatio in gradle.properties is dynamic, fitHorizontal, fitVertical, fixed, or stretched, not \"$mode\".")
        }
        val frameRate = when (val rate = value("game.frameRate")) {
            "display" -> "TargetFrameRate.DisplayDefault"
            else -> "TargetFrameRate.Limit(" + (
                rate.toIntOrNull()?.takeIf { it in 1..1000 }
                    ?: throw GradleException("game.frameRate in gradle.properties is a whole number from 1 to 1000, or display, not \"$rate\".")
                ) + ")"
        }
        val firstScene = value("game.firstScene").takeIf { it.split('/').all { part -> Regex("[A-Za-z0-9][A-Za-z0-9_-]*").matches(part) } }
            ?: throw GradleException("game.firstScene in gradle.properties is a Scene's name, like levels/1-1, not \"${value("game.firstScene")}\".")
        directory.get().file("GameSettings.kt").asFile.apply {
            parentFile.mkdirs()
            writeText(
                """
                |package {{PACKAGE}}
                |
                |import com.pandulapeter.kubriko.helpers.extensions.sceneUnit
                |import com.pandulapeter.kubriko.manager.ViewportManager
                |import com.pandulapeter.kubriko.types.SceneSize
                |import com.pandulapeter.kubriko.types.TargetFrameRate
                |
                |object GameSettings {
                |    const val FIRST_SCENE = "$firstScene"
                |    val ASPECT_RATIO_MODE: ViewportManager.AspectRatioMode = $aspectRatioMode
                |    val TARGET_FRAME_RATE: TargetFrameRate = $frameRate
                |}
                |""".trimMargin(),
            )
        }
    }
}

kotlin.sourceSets.commonMain {
    kotlin.srcDir(generateGameSettings)
}
