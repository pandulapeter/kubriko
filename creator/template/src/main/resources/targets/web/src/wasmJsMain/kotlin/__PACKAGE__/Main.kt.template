package {{PACKAGE}}

import androidx.compose.foundation.layout.fillMaxSize
import androidx.compose.ui.ExperimentalComposeUiApi
import androidx.compose.ui.Modifier
import androidx.compose.ui.window.ComposeViewport
import {{PACKAGE}}.generated.KubrikoWiring

@OptIn(ExperimentalComposeUiApi::class)
fun main() {
    useValidBrowserLanguage()
    KubrikoWiring.isLoggingEnabled = creatorParameter("kubriko.creator.logging").toBoolean()
    KubrikoWiring.firstSceneOverride = creatorParameter("kubriko.creator.scene")
    ComposeViewport {
        Game(
            modifier = Modifier.fillMaxSize(),
        )
    }
}

/**
 * A parameter of the page's address that Kubriko Creator sets when it plays the game, read only on a page served from
 * this computer.
 */
private fun creatorParameter(name: String): String? = js("['127.0.0.1', 'localhost', '[::1]'].includes(location.hostname) ? new URLSearchParams(location.search).get(name) : null")

/**
 * Hands Compose the browser's languages without a modifier such as `@posix`, which a browser started under the POSIX
 * locale reports (`en-US@posix`): Compose reads them as language tags, and draws no text at all when one isn't.
 */
private fun useValidBrowserLanguage(): Unit = js("""{
    const isValid = (tag) => { try { new Intl.Locale(tag); return true; } catch (e) { return false; } };
    const reported = navigator.languages || [navigator.language];
    if (!reported.every(isValid)) {
        const valid = reported.map((tag) => tag.split('@')[0]).filter(isValid);
        const languages = valid.length > 0 ? valid : ['en-US'];
        Object.defineProperty(navigator, 'languages', { get: () => languages });
        Object.defineProperty(navigator, 'language', { get: () => languages[0] });
    }
}""")
